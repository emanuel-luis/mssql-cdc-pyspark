# Copy to .env. Used by docker compose and by the lab scripts.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_DATABASE=cdc_lab
# Server clock timezone for the container (see docker-compose.yml)
MSSQL_TZ=UTC
# Windows time zone name matching MSSQL_TZ, passed to the source as sourceTimeZone.
# UTC -> UTC ; America/Sao_Paulo -> E. South America Standard Time
MSSQL_SOURCE_TZ=UTC
