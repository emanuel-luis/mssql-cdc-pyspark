# Copy to .env. Used by docker compose and by the lab scripts.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_DATABASE=cdc_lab
# Server clock timezone for the container (see docker-compose.yml)
MSSQL_TZ=UTC
# sourceTimeZone for the source. auto = CURRENT_TIMEZONE_ID() (SQL Server 2022+);
# otherwise the Windows zone name, e.g. America/Sao_Paulo -> E. South America Standard Time
MSSQL_SOURCE_TZ=auto
