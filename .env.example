# Copy to .env. Used by docker compose and by the lab scripts.
# Choose one (8+ characters, three of: upper, lower, digit, symbol); compose will not start
# without it.
MSSQL_SA_PASSWORD=
# 127.0.0.1, not localhost: compose publishes the port on IPv4 loopback only, and localhost
# can resolve to ::1 first (WSL), where the driver then fails with TCP error 0x2749.
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_DATABASE=cdc_lab
# Server clock timezone for the container (see docker-compose.yml)
MSSQL_TZ=UTC
# sourceTimeZone for the source. auto = CURRENT_TIMEZONE_ID() on SQL Server 2022+, the
# current UTC offset before that; or the Windows zone name, e.g. America/Sao_Paulo ->
# E. South America Standard Time (needed for zones with daylight saving before 2022)
MSSQL_SOURCE_TZ=auto
# SQL Server image for docker compose, default mcr.microsoft.com/mssql/server:2022-latest.
# Another version needs its own data volume: a compose project of its own (see LAB.md).
# MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2017-latest
